{
  "status": "experimental",
  "purpose": "Deterministic raw JSON portability corpus for rfc8785-jcs-v1-experimental.",
  "cases": [
    {"id":"ascii","source":"{\"a\":1}","expected":"accepted"},
    {"id":"duplicate_decoded_key","source":"{\"a\":1,\"\\u0061\":2}","expected":"malformed"},
    {"id":"deep_object","source":"{\"a\":{\"b\":{\"c\":{\"d\":[1,2,3]}}}}","expected":"accepted"},
    {"id":"extra_field","source":"{\"required\":true,\"unexpected\":\"x\"}","expected":"accepted"},
    {"id":"null","source":"{\"value\":null}","expected":"accepted"},
    {"id":"empty_containers","source":"{\"array\":[],\"object\":{}}","expected":"accepted"},
    {"id":"wrong_primitive","source":"{\"status\":7}","expected":"accepted"},
    {"id":"zero","source":"{\"n\":0}","expected":"accepted"},
    {"id":"zero_decimal","source":"{\"n\":0.0}","expected":"accepted"},
    {"id":"negative_zero_integer","source":"{\"n\":-0}","expected":"malformed"},
    {"id":"negative_zero_decimal","source":"{\"n\":-0.0}","expected":"malformed"},
    {"id":"safe_integer_max","source":"{\"n\":9007199254740991}","expected":"accepted"},
    {"id":"safe_integer_min","source":"{\"n\":-9007199254740991}","expected":"accepted"},
    {"id":"unsafe_integer_min","source":"{\"n\":-9007199254740992}","expected":"malformed"},
    {"id":"unsafe_integer","source":"{\"n\":9007199254740992}","expected":"malformed"},
    {"id":"decimal","source":"{\"n\":0.125}","expected":"accepted"},
    {"id":"exponent","source":"{\"n\":1e-7}","expected":"accepted"},
    {"id":"integral_exponent","source":"{\"n\":1e3}","expected":"accepted"},
    {"id":"very_small","source":"{\"n\":5e-324}","expected":"accepted"},
    {"id":"large_integral_float","source":"{\"n\":1e20}","expected":"malformed"},
    {"id":"nan","source":"{\"n\":NaN}","expected":"malformed"},
    {"id":"infinity","source":"{\"n\":Infinity}","expected":"malformed"},
    {"id":"negative_infinity","source":"{\"n\":-Infinity}","expected":"malformed"},
    {"id":"utf8","source":"{\"label\":\"café 🚀\"}","expected":"accepted"},
    {"id":"combining","source":"{\"label\":\"e\\u0301\"}","expected":"accepted"},
    {"id":"nfc","source":"{\"label\":\"é\"}","expected":"accepted"},
    {"id":"escaped_unicode","source":"{\"label\":\"\\u00e9\"}","expected":"accepted"},
    {"id":"unpaired_high_surrogate","source":"{\"label\":\"\\ud800\"}","expected":"malformed"},
    {"id":"unpaired_low_surrogate","source":"{\"label\":\"\\udc00\"}","expected":"malformed"},
    {"id":"paired_surrogate","source":"{\"label\":\"\\ud83d\\ude80\"}","expected":"accepted"},
    {"id":"canonical_timestamp","source":"{\"issued_at\":\"2030-01-01T12:00:00Z\"}","expected":"accepted"},
    {"id":"offset_timestamp","source":"{\"issued_at\":\"2030-01-01T07:00:00-05:00\"}","expected":"accepted"},
    {"id":"fractional_timestamp","source":"{\"issued_at\":\"2030-01-01T12:00:00.1Z\"}","expected":"accepted"},
    {"id":"lowercase_z","source":"{\"issued_at\":\"2030-01-01T12:00:00z\"}","expected":"accepted"},
    {"id":"malformed_json","source":"{\"a\":}","expected":"malformed"}
